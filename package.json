{
  "name": "@luka-cat-mimi/n8n-nodes-kingdee",
  "version": "0.1.1",
  "description": "金蝶云星空 N8N 集成插件",
  "keywords": [
    "n8n",
    "n8n-node",
    "n8n-community-node-package",
    "kingdee",
    "金蝶",
    "金蝶云星空"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "homepage": "https://github.com/luka-n8n-nodes/n8n-nodes-kingdee#readme",
  "author": {
    "name": "luka-cat",
    "email": "luka.cat.mimi@gmail.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/luka-n8n-nodes/n8n-nodes-kingdee.git"
  },
  "main": "index.js",
  "scripts": {
    "build": "n8n-node build",
    "dev": "n8n-node dev",
    "format": "prettier nodes credentials --write",
    "lint": "n8n-node lint",
    "lintfix": "n8n-node lint --fix"
  },
  "files": [
    "dist"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "credentials": [
      "dist/credentials/KingdeeAppAuthApi.credentials.js",
      "dist/credentials/KingdeePasswordApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/Kingdee/Kingdee.node.js"
    ]
  },
  "devDependencies": {
    "@n8n/node-cli": "*",
    "@types/node": "^20.19.37",
    "eslint": "9.39.4",
    "prettier": "3.8.1",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "glob": "^10.4.5"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  }
}
